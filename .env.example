# Storage backend: vercel (default) | r2 | local
STORAGE_BACKEND=vercel
# Object key prefix for JSON state files
STORAGE_PREFIX=workspace

# --- Vercel Blob (default) ---
# Local: create a Blob store in the Vercel dashboard and paste the token.
# On Vercel: prefer OIDC + BLOB_STORE_ID after linking a store to the project.
BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# --- Cloudflare R2 (optional) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=agent-files
# R2_PUBLIC_BASE_URL=

# --- Eve / AI Gateway ---
# Preferred: link the project then pull OIDC (short-lived, ~12h):
#   npx vercel link --yes && npx vercel env pull .env.local --yes
# That writes VERCEL_OIDC_TOKEN. On Vercel deployments OIDC is automatic.
# Fallback only: create a key at https://vercel.com/dashboard/ai/api-keys
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=   # written by `vercel env pull`; do not invent manually
