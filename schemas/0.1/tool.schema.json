{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tool",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "not": {
        "pattern": "[^a-z0-9-]"
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "config": {
      "type": "object"
    },
    "source": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "description"
  ],
  "additionalProperties": false
}
